# Server-only values. Never commit .env or put the license in NEXT_PUBLIC_*.
APRYSE_LICENSE_KEY=
ENABLE_CONTENT_EDITING=false
ENABLE_OCR=false
APRYSE_RESOURCE_PATH=/opt/apryse/resources
FIREBASE_PROJECT_ID=parperly
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
ALLOWED_ORIGINS=https://parperly.com,https://www.parperly.com
HOST=0.0.0.0
PORT=8081
