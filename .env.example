# Browser Firebase configuration is public identification, not an admin secret.
# Current public project configuration: packages/config/firebase-public.json
NEXT_PUBLIC_BASE_PATH=/parperly
# Server deployment is deliberately disabled until integration/security testing.
ENABLE_SERVER_PROCESSING=false
FIREBASE_PROJECT_ID=parperly
PRIVATE_STORAGE_BUCKET=
REDIS_URL=
ALLOWED_ORIGINS=https://usmanarif60180-cyber.github.io
PORT=8080
DAILY_TASK_LIMIT=20
# Use workload identity / application default credentials on the server.
# Never put service-account JSON or privileged tokens in NEXT_PUBLIC variables.
