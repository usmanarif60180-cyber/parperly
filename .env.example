# Browser Firebase configuration is public identification, not an admin secret.
# Current public project configuration: packages/config/firebase-public.json
NEXT_PUBLIC_BASE_PATH=
# Server deployment is deliberately disabled until integration/security testing.
ENABLE_SERVER_PROCESSING=false
FIREBASE_PROJECT_ID=parperly
PRIVATE_STORAGE_BUCKET=
REDIS_URL=
ALLOWED_ORIGINS=https://parperly.com,https://www.parperly.com
PORT=8080
DAILY_TASK_LIMIT=20
# Use workload identity / application default credentials on the server.
# Never put service-account JSON or privileged tokens in NEXT_PUBLIC variables.

# Optional licensed editor service URL (public URL only; never a license key)
NEXT_PUBLIC_EDITOR_API_URL=

# Optional browser content editor. A Server SDK secret must NEVER go here.
# Only a vendor-approved browser-distributable WebViewer license is suitable.
NEXT_PUBLIC_APRYSE_CONTENT_EDIT_ENABLED=false
NEXT_PUBLIC_APRYSE_WEBVIEWER_LICENSE_KEY=
APRYSE_BROWSER_LICENSE_APPROVED=false
# Local evaluation only; always leave unset/false in public deployments.
NEXT_PUBLIC_APRYSE_LOCAL_TRIAL=false

# Keep true for any explicitly approved public evaluation license.
NEXT_PUBLIC_APRYSE_EVALUATION=false
