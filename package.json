{
  "name": "paperly",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:assets && next dev apps/web --hostname 127.0.0.1 --port 8766",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "npm run prepare:assets && next build apps/web --webpack",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker-node/src/index.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "fixtures": "tsx scripts/create-fixtures.ts"
  },
  "dependencies": {
    "@pdftron/webviewer": "12.3.0",
    "bullmq": "6.7.8",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
